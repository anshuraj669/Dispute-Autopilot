# --- Mode ---------------------------------------------------------------
# "mock"    = built-in sample disputes, no PayPal credentials needed (good for judges)
# "sandbox" = real PayPal sandbox account
PAYPAL_MODE=mock

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) --
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section (needed to verify signatures)
PAYPAL_WEBHOOK_ID=
# Exposed to the browser for the demo store's PayPal buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Merchant profile the agent reasons with ------------------------------
MERCHANT_NAME=Lumen Candle Co.
MERCHANT_REFUND_POLICY=Returns accepted within 30 days of delivery for unused items. Buyer pays return shipping unless the item arrived damaged.
# Disputes at or below this amount (USD) are cheaper to refund than to fight
AUTO_ACCEPT_THRESHOLD=15

# --- Carrier tracking (optional) ---------------------------------------------
# Shippo API token for real delivery lookups in sandbox mode. Demo mode uses
# simulated tracking. Test tokens (shippo_test_...) only track SHIPPO_* numbers.
SHIPPO_API_KEY=

# --- Impact math on the dashboard (defaults; editable on the Settings page) ---
# What losing a dispute costs on top of the refund (PayPal's dispute fee, USD)
DISPUTE_FEE_USD=15
# Minutes a merchant spends handling one dispute by hand (for "hours saved")
MANUAL_MINUTES_PER_DISPUTE=45
